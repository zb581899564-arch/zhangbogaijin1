@@ -0,0 +1,83 @@
+package org.uma.jmetal.util.research.search;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Random;
+import org.uma.jmetal.solution.PermutationSolution;
+import org.uma.jmetal.util.research.SchedulingEncoding;
+import org.uma.jmetal.util.research.model.Instance;
+import org.uma.jmetal.util.research.model.ModelKind;
+import org.uma.jmetal.util.research.runtime.SeededRandom;
+
+/** Nine chapter-specific neighborhoods, all operating on a copied candidate in one factory. */
+public final class IntraNeighborhoods {
+    public static final int COUNT = 9;
+    private final Instance instance;
+    public IntraNeighborhoods(Instance instance) { this.instance = instance; }
+
+    public PermutationSolution<Integer> propose(PermutationSolution<Integer> parent, int factory, int operator) {
+        if (operator < 0 || operator >= COUNT) throw new IllegalArgumentException("Neighborhood must be 0..8");
+        PermutationSolution<Integer> child = ParetoTools.copy(parent);
+        List<Integer> positions = positions(child, factory);
+        if (operator < 3) permute(child.getVariables(), positions, operator);
+        else if (instance.kind() == ModelKind.CHAPTER3_FIXED_WORKER) {
+            if (operator < 6) permute(ParticleOperators.machines(child), positions, operator - 3);
+            else permute(child.getVariablesworker(), fixedWorkerPositions(factory), operator - 6);
+        } else if (operator == 5) permute(ParticleOperators.machines(child), positions, 2);
+        else if (operator == 8) permute(child.getVariablesworker(), positions, 2);
+        else reallocate(child, factory, positions, operator < 6, operator == 4 || operator == 7);
+        SchedulingEncoding.repair(child, instance);
+        return child;
+    }
+
+    private void reallocate(PermutationSolution<Integer> child, int factory, List<Integer> positions,
+            boolean machine, boolean capacity) {
+        if (positions.isEmpty()) return;
+        List<Integer> vector = machine ? ParticleOperators.machines(child) : child.getVariablesworker();
+        int size = machine ? instance.machines(factory, 0) : instance.workers(factory, 0);
+        if (size < 2) return;
+        int[] load = new int[size];
+        for (int p : positions) load[vector.get(p)]++;
+        int source = -1, target = 0;
+        for (int resource = 0; resource < size; resource++) {
+            if (load[resource] > 0 && (source < 0 || (capacity
+                    ? capacity(factory, resource, machine) < capacity(factory, source, machine)
+                    : load[resource] > load[source]))) source = resource;
+            if (capacity ? capacity(factory, resource, machine) > capacity(factory, target, machine)
+                         : load[resource] < load[target]) target = resource;
+        }
+        if (source == target) return;
+        List<Integer> movable = new ArrayList<>();
+        for (int p : positions) if (vector.get(p) == source) movable.add(p);
+        int chosen = movable.get(SeededRandom.current().nextInt(movable.size()));
+        vector.set(chosen, target);
+    }
+    private double capacity(int factory, int resource, boolean machine) {
+        return machine ? instance.speed(factory, 0, resource) : instance.efficiency(factory, 0, resource);
+    }
+    private static List<Integer> positions(PermutationSolution<Integer> solution, int factory) {
+        List<Integer> result = new ArrayList<>();
+        for (int p = 0; p < solution.getNumberOfVariables(); p++) if (solution.getVariableValueid(p) == factory) result.add(p);
+        return result;
+    }
+    private List<Integer> fixedWorkerPositions(int factory) {
+        int offset = 0;
+        for (int f = 0; f < factory; f++) offset += instance.workers(f, 0);
+        List<Integer> result = new ArrayList<>();
+        for (int i = 0; i < instance.workers(factory, 0); i++) result.add(offset + i);
+        return result;
+    }
+    private static void permute(List<Integer> vector, List<Integer> positions, int operation) {
+        if (positions.size() < 2) return;
+        Random random = SeededRandom.current();
+        int a = random.nextInt(positions.size()), b = random.nextInt(positions.size() - 1);
+        if (b >= a) b++;
+        List<Integer> values = new ArrayList<>();
+        for (int p : positions) values.add(vector.get(p));
+        if (operation == 0) { Integer value = values.remove(b); values.add(a, value); }
+        else if (operation == 1) Collections.reverse(values.subList(Math.min(a, b), Math.max(a, b) + 1));
+        else Collections.swap(values, a, b);
+        for (int i = 0; i < positions.size(); i++) vector.set(positions.get(i), values.get(i));
+    }
+}
--- original/jmetal-core/src/main/java/org/uma/jmetal/util/research/search/LocalSearch.java
+++ chapter3/jmetal-core/src/main/java/org/uma/jmetal/util/research/search/LocalSearch.java
@@ -0,0 +1,93 @@
+package org.uma.jmetal.util.research.search;
+
+import java.util.List;
+import org.uma.jmetal.solution.PermutationSolution;
+import org.uma.jmetal.util.research.FactoryNeighborhoods;
+import org.uma.jmetal.util.research.model.Instance;
+import org.uma.jmetal.util.research.runtime.SeededRandom;
+
+/** Inter-factory load balancing followed by QLS (chapter 3) or random-factory VNS (chapter 4). */
+final class LocalSearch {
+    private final Instance instance;
+    private final int chapter;
+    private final SearchConfig config;
+    private final SearchState state;
+    private final IntraNeighborhoods neighborhoods;
+    LocalSearch(Instance instance, int chapter, SearchConfig config, SearchState state) {
+        this.instance = instance; this.chapter = chapter; this.config = config; this.state = state;
+        neighborhoods = new IntraNeighborhoods(instance);
+    }
+    Particle improve(Particle particle, Direction direction, List<PermutationSolution<Integer>> reference) {
+        return improveIntra(improveInter(particle, direction, reference), direction, reference);
+    }
+    Particle improveInter(Particle particle, Direction direction, List<PermutationSolution<Integer>> reference) {
+        return particle.descend(inter(particle.current, direction, reference));
+    }
+    Particle improveIntra(Particle particle, Direction direction, List<PermutationSolution<Integer>> reference) {
+        PermutationSolution<Integer> current = particle.current;
+        if (chapter == 3) {
+            QTable table = new QTable(instance.factories(), config.alpha, config.gamma);
+            int observation = 1;
+            for (int q = 0; q < config.qIterations; q++) {
+                int factory = table.choose(observation, config.exploration);
+                PermutationSolution<Integer> next = vns(current, factory, direction, reference);
+                double reward = direction.reward(current, next);
+                int nextState = direction.state(reward, chapter);
+                table.update(observation, factory, reward, nextState);
+                state.count("qls.g" + direction.id() + ".updates");
+                observation = nextState;
+                current = next; // Each action continues from the previous action's result.
+            }
+        } else {
+            int factory = SeededRandom.current().nextInt(instance.factories());
+            current = vns(current, factory, direction, reference);
+        }
+        return particle.descend(current);
+    }
+    private PermutationSolution<Integer> inter(PermutationSolution<Integer> parent, Direction direction,
+            List<PermutationSolution<Integer>> reference) {
+        PermutationSolution<Integer> current = parent;
+        int operator = 0;
+        while (operator < 2) {
+            PermutationSolution<Integer> child = FactoryNeighborhoods.move(current, direction.id(), operator == 0, instance);
+            state.count("inter.operator" + operator + ".proposals");
+            state.evaluate(child, "inter", direction);
+            if (direction.better(child, current, reference)) {
+                current = child; operator = 0;
+                state.count("inter.accepted");
+            } else operator++;
+        }
+        return current;
+    }
+    private PermutationSolution<Integer> vns(PermutationSolution<Integer> parent, int factory,
+            Direction direction, List<PermutationSolution<Integer>> reference) {
+        PermutationSolution<Integer> incumbent = parent;
+        int operator = 0;
+        int[] remaining = {config.localProposalCap};
+        while (operator < IntraNeighborhoods.COUNT && remaining[0] > 0) {
+            PermutationSolution<Integer> shaken = evaluateNeighborhood(incumbent, factory, operator, direction, remaining);
+            PermutationSolution<Integer> improved = descent(shaken, factory, direction, reference, remaining);
+            if (direction.better(improved, incumbent, reference)) {
+                incumbent = improved; operator = 0; state.count("intra.accepted");
+            } else operator++;
+        }
+        return incumbent;
+    }
+    private PermutationSolution<Integer> descent(PermutationSolution<Integer> parent, int factory,
+            Direction direction, List<PermutationSolution<Integer>> reference, int[] remaining) {
+        PermutationSolution<Integer> incumbent = parent;
+        int operator = 0;
+        while (operator < IntraNeighborhoods.COUNT && remaining[0] > 0) {
+            PermutationSolution<Integer> child = evaluateNeighborhood(incumbent, factory, operator, direction, remaining);
+            if (direction.better(child, incumbent, reference)) { incumbent = child; operator = 0; }
+            else operator++;
+        }
+        return incumbent;
+    }
+    private PermutationSolution<Integer> evaluateNeighborhood(PermutationSolution<Integer> parent, int factory,
+            int operator, Direction direction, int[] remaining) {
+        remaining[0]--;
+        state.count("intra.neighborhood" + operator + ".proposals");
+        return state.evaluate(neighborhoods.propose(parent, factory, operator), "intra", direction);
+    }
+}
